{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "lib": [
            "ES2022"
        ],
        "outDir": "./dist/cjs",
        "rootDir": "./src",
        "declaration": false,
        "declarationMap": false,
        "sourceMap": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "removeComments": false
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "__tests__",
        "examples"
    ]
}